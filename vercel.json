      "source": "/lock/:id",
      "destination": "/api/c?view=lock&id=:id"
    },
    {
      "source": "/predict/me/:u",
      "destination": "/api/c?view=predictme&u=:u"
    },
    {
      "source": "/orders/fill/:tx",
      "destination": "/api/c?view=ordfill&tx=:tx"
    },
    {
      "source": "/predict/:id",
      "destination": "/api/c?view=predict&id=:id"
    },
    {
      "source": "/nft/:id",
      "destination": "/api/c?view=nft&id=:id"
    },
    {
      "source": "/stake/:id",
      "destination": "/api/c?view=stake&id=:id"
    },
    {
      "source": "/vearcia/:id",
      "destination": "/api/c?view=vearcia&id=:id"
    },
    {
      "source": "/mine/:id",
      "destination": "/api/mine?view=page&page=:id"
    },
    {
      "source": "/embed/mine/:id",
      "destination": "/api/mine?view=embed&embed=:id"
    },
    {
      "source": "/lockbadge/:addr",
      "destination": "/api/social?lockbadge=:addr"
    },
    {
      "source": "/circle/round/:n",
      "destination": "/api/c?view=report&n=:n"
    },
    {
      "source": "/vote/:tx",
      "destination": "/api/c?view=vote&tx=:tx"
    },
    {
      "source": "/api/v1/snapshot/:addr",
      "destination": "/api/social?snapapi=:addr"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "arcirclepad.vercel.app"
        }
      ],
      "destination": "https://www.arcircle.app/:path*",
      "permanent": false
    },
    {
      "source": "/locker",
      "destination": "/arc#locker",
      "permanent": false
    },
    {
      "source": "/bridge",
      "destination": "/arc#bridge",
      "permanent": false
    },
    {
      "source": "/scanner",
      "destination": "/arc#scanner",
      "permanent": false
    },
    {
      "source": "/multisend",
      "destination": "/arc#multisend",
      "permanent": false
    },
    {
      "source": "/multisender",
      "destination": "/arc#multisend",
      "permanent": false
    },
    {
      "source": "/snapshot",
      "destination": "/arc#snapshot",
      "permanent": false
    },
    {
      "source": "/relay",
      "destination": "/arc#relay",
      "permanent": false
    },
    {
      "source": "/arcia",
      "destination": "/arc#arcia",
      "permanent": false
    },
    {
      "source": "/liquidity",
      "destination": "/arc#liquidity",
      "permanent": false
    },
    {
      "source": "/claim/:id",
      "destination": "/arc#multisend?claim=:id",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!embed/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/arcia402?hire=1",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/arcia-x",
      "schedule": "5 12 * * *"
    }
  ],
  "functions": {
    "api/arcia-x.mjs": {
      "maxDuration": 60
    },
    "api/arcia.mjs": {
      "maxDuration": 30
    },
    "api/arcia402.mjs": {
      "maxDuration": 60
    },
    "api/arcia-tg.mjs": {
      "maxDuration": 60
    },
    "api/mine.mjs": {
      "maxDuration": 60
    },
    "api/scan.mjs": {
      "maxDuration": 60
    },
    "api/desk.mjs": {
      "maxDuration": 60
    }
  }
}
