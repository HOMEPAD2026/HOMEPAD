    },
    {
      "source": "/snap/:id",
      "destination": "/api/c?view=snap&id=:id"
    },
    {
      "source": "/lplock/:id",
      "destination": "/api/c?view=lplock&id=:id"
    },
    {
      "source": "/bx/:src/:tx",
