      "destination": "/api/scan?rep=:id"
    },
    {
      "source": "/scan-report/:id",
      "destination": "/api/scan?reppage=:id"
    },
    {
      "source": "/embed/scan/:addr",
      "destination": "/api/scan?embed=:addr"
    },
    {
      "source": "/api/v1/scan/:addr",
      "destination": "/api/social?scanapi=:addr"
    },
    {
