# Copy this to .env and fill in real values. Never commit .env.

# Robinhood Chain testnet: chainId 46630, RPC https://rpc.testnet.chain.robinhood.com
# Robinhood Chain mainnet: chainId 4663 — get the mainnet RPC from Robinhood's own docs.
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Deployer wallet's private key. Use a burner/dedicated deploy wallet, not
# your main $HOME treasury or personal wallet.
DEPLOYER_PRIVATE_KEY=

# Where trade fees end up.
HOME_TREASURY_ADDRESS=
PLATFORM_WALLET_ADDRESS=

# Look this up fresh at deploy time — do not copy an address from an old
# tutorial. Check Uniswap's deployments page or Robinhood Chain's docs for
# the current Uniswap V2 Router02 address on the network you're deploying to.
UNISWAP_V2_ROUTER=

# MVP defaults — tune before mainnet.
INITIAL_VIRTUAL_ETH=3
GRADUATION_THRESHOLD=10
BASE_FEE_BPS=100
CREATOR_SHARE_BPS=7000
HOME_SHARE_BPS=10000

# --- Stock-paired mode (scripts/deploy-stock.js) ---
# Comma-separated Stock Token addresses. Look these up fresh at
# https://docs.robinhood.com/chain/contracts — that page is generated live
# from the on-chain registry.
STOCK_QUOTE_TOKENS=

# --- Uniswap V4 mode (scripts/deploy-v4.js) ---
# Robinhood Chain TESTNET official addresses (confirmed):
#   PoolManager:      0x552815eF68E6eb418A3d65D0AA1043d93204F612
#   PositionManager:  0x00EB6902D1e3be1A8C667041f9E75b77B7Ad3ba6  (not used by this project — see contracts README)
#   Universal Router: 0xE28c0e44F4016b073db20cF28971CAc6ce3664D3  (not used by this project)
#   Permit2:          0x000000000022D473030F116dDEE9F6B43aC78BA3  (not used by this project)
# BondingCurveV4 only needs POOL_MANAGER_ADDRESS — it talks to the core
# PoolManager directly rather than through PositionManager (see the V4
# section of README.md for why). Re-verify these before mainnet — this
# list is testnet only.
POOL_MANAGER_ADDRESS=
POOL_FEE=3000
TICK_SPACING=60

# --- RENT distribution (scripts/distribute-rent.js) ---
# This one runs against MAINNET (where $HOME actually lives), not
# testnet — see the robinhoodMainnet network in hardhat.config.js.
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
# The $HOME treasury wallet's own key. Only needed if you want the
# script to send the creator-incentive/operations transfers directly —
# leave blank and just answer "n" to those prompts to skip that part.
# Never reuse a testnet deploy key here; this touches real funds.
TREASURY_PRIVATE_KEY=
CREATOR_INCENTIVE_WALLET=
OPERATIONS_WALLET=
# Optional — override the default 50/30/10/10 split (basis points, must
# sum to 10000).
RENT_BUYBACK_BPS=5000
RENT_LIQUIDITY_BPS=3000
RENT_CREATOR_BPS=1000
RENT_OPS_BPS=1000
