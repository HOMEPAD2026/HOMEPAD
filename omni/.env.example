# ARCIRCLE OMNI — copy to .env and fill in yourself. Never paste keys into chat, issues or commits.
# The deployer only deploys; ownership goes to the multisig right away (OMNI_OWNER).

# EVM deployer (a fresh key used only for deploying — NOT the old 0x80e1…8bc7 key, which was exposed)
PRIVATE_KEY=

# Safe 2-of-3 that owns every OMNI contract and is the LayerZero delegate on each chain (decided).
# Create it in the Safe app with the SAME address on Arc and Robinhood Chain (ROBINHOOD.md step 1).
OMNI_OWNER=
# only if the Safe ended up with a different address on one chain: per-chain overrides
OMNI_OWNER_ARC=
OMNI_OWNER_ROBINHOOD=
# optional: a monitoring bot / 1-of-N Safe that can pause (never unpause)
OMNI_GUARDIAN=
# where USDC rewards earned by the Arc lockbox are swept. Policy (decided): they go to the burn engine —
# the Safe buys $ARCIRCLE with them and sends it to 0x…dEaD. Leave empty to use OMNI_OWNER (the Safe);
# later point it at the automated burn contract with setRewardsReceiver.
OMNI_REWARDS_RECEIVER=

RPC_URL_ARC=https://rpc.mainnet.arc.io
RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com

# the second required DVN (LayerZero Labs is always the first) — one of: Nethermind, Horizen, Canary, P2P, Nansen
# (the operators listed, not deprecated, on BOTH Arc and Robinhood Chain; see layerzero.config.ts)
OMNI_SECOND_DVN=Nethermind
# per destination, per rolling 24h, in whole $ARCIRCLE (decided: 10000000 = 1% of supply; raise later via the Safe)
OMNI_DAILY_LIMIT=10000000
# phase 2 only: set to 1 after solana/README.md to add Solana to the mesh
OMNI_SOLANA=
# Solana (see solana/README.md)
SOLANA_PRIVATE_KEY=
RPC_URL_SOLANA=https://api.mainnet-beta.solana.com
